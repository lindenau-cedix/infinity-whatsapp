# =============================================================================
# Infinity — credential vault template
# Copy to .env (gitignored) and fill in real values. Each key below is read by
# src/credentials.ts and exposed to adapters as `ctx.credentials.<name>`.
# Rotation cadence is documented in docs/credential-vault.md.
# =============================================================================

# -----------------------------------------------------------------------------
# Qwen Code (LOCAL CLI; no API key, no cloud endpoint)
# Used by: dispatcher/qwen.js (group: "Qwen")
# Install:  https://github.com/QwenLM/Qwen3-Coder
# Invoked as:  qwen -m ${QWEN_MODEL} -p "[PROMPT]"
# Per INFA-17 the model is fixed at qwen3:30b-a3b unless overridden here.
# -----------------------------------------------------------------------------
QWEN_BIN=qwen
QWEN_MODEL=qwen3:30b-a3b

# -----------------------------------------------------------------------------
# Perplexity — sonar-reasoning-pro
# Used by: adapters/perplexityReasoning.ts (group: "Perp. RP")
# Issue it: https://www.perplexity.ai/settings/api
# Rotation: every 90 days.
# -----------------------------------------------------------------------------
PERPLEXITY_REASONING_API_KEY=
PERPLEXITY_REASONING_MODEL=sonar-reasoning-pro

# -----------------------------------------------------------------------------
# Perplexity — sonar-deep-research
# Used by: adapters/perplexityDeepResearch.ts (group: "Perp. DR")
# Issue it: same Perplexity console; can reuse the same key as RP, but separate
# keys let you rotate / revoke one product without touching the other.
# Rotation: every 90 days.
# -----------------------------------------------------------------------------
PERPLEXITY_DEEP_RESEARCH_API_KEY=
PERPLEXITY_DEEP_RESEARCH_MODEL=sonar-deep-research

# -----------------------------------------------------------------------------
# Firecrawl (web scraping + structured extraction)
# Used by: adapters/firecrawl.ts (group: "Firecrawl")
# Issue it: https://firecrawl.dev (dashboard -> API Keys)
# Rotation: every 180 days; Firecrawl keys are higher-entropy than the rest.
# -----------------------------------------------------------------------------
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# -----------------------------------------------------------------------------
# OpenAI Whisper (voice transcription — NOT owned by Endpoints Integrator,
# but lives in this vault so one source of truth covers all media keys).
# Used by: Voice & Media Engineer. We only validate presence at boot.
# Rotation: every 180 days.
# -----------------------------------------------------------------------------
OPENAI_WHISPER_API_KEY=

# -----------------------------------------------------------------------------
# ElevenLabs (text-to-speech for the "Antworte sprachlich" prefix).
# Not owned by Endpoints Integrator; presence-validated only.
# Rotation: every 180 days.
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# -----------------------------------------------------------------------------
# Local media folder for path-references (not a credential, but lives next to
# the vault so adapters resolve media consistently).
# -----------------------------------------------------------------------------
INFINITY_MEDIA_DIR=./media