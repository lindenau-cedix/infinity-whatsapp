{
  "name": "infinity-whatsapp-client",
  "version": "0.1.0",
  "description": "WhatsApp transport for Infinity — listens to 4 configured groups and dispatches prompts to the Endpoints Integrator.",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "infinity-whatsapp": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "pair": "node dist/cli.js --print-qr"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
