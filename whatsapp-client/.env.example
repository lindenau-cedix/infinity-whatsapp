# =============================================================================
# Infinity WhatsApp client — environment template.
# Copy to .env (gitignored) and fill in real values.
# Group identifiers are the WhatsApp JIDs of the four routing groups.
# Group names are informational only; the router keys off the JID.
# =============================================================================

# --- WhatsApp Web session ---------------------------------------------------
# Where the LocalAuth credential bundle lives. Defaults to ./.wa-session.
WA_SESSION_PATH=./.wa-session
# Headless chromium flag. Leave true for server deploys; flip to false for
# local debugging where you want to see the browser.
WA_HEADLESS=true

# --- Group registry ---------------------------------------------------------
# Exactly four JIDs must be set. The router uses these to decide which
# endpoint a message should be delegated to.
WA_GROUP_JID_QWEN=
WA_GROUP_JID_PERP_RP=
WA_GROUP_JID_PERP_DR=
WA_GROUP_JID_FIRECRAWL=

# --- Media persistence ------------------------------------------------------
# Local folder for downloaded image / video / voice attachments.
INFINITY_MEDIA_DIR=./media

# --- Logging ---------------------------------------------------------------
# One of: silent | error | warn | info | debug
LOG_LEVEL=info

# --- Endpoints Integrator credentials --------------------------------------
# These are read directly by endpoints-integrator/dispatcher/* when the
# daemon runs. Qwen is local and needs no key. Missing values here cause
# the corresponding group to reply with a "Stub" message that points the
# operator at the missing key — see INFA-20. Per-model overrides win
# when both are set.
#
# Perplexity (https://www.perplexity.ai/settings/api) — used by groups
# "Perp. RP" (sonar-reasoning-pro) and "Perp. DR" (sonar-deep-research).
PERPLEXITY_API_KEY=
PERPLEXITY_REASONING_API_KEY=
PERPLEXITY_DEEP_RESEARCH_API_KEY=
#
# Firecrawl (https://firecrawl.dev) — used by group "Firecrawl".
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
